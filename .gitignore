cat > .gitignore << 'EOF'
# Python / Django
backend/venv/
backend/__pycache__/
backend/**/__pycache__/
backend/**/*.pyc
backend/.env
backend/media/
backend/staticfiles/
backend/db.sqlite3

# Node / React
frontend/node_modules/
frontend/dist/
frontend/.env

# Système
.DS_Store
*.log
.idea/
.vscode/
EOF